{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": ".",
      "entrypoint": "analyzer:app"
    }
  },
  "env": {
    "MAX_UPLOAD_BYTES": "4194304"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/healthz",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/docs/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/redoc/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
